# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
/release/
/release-*/
/electron-dist-*/
/resources/bin/*
!/resources/bin/README.md
# 临时验证构建产物。原来只覆盖了 .verify-dist-* 和 .codex-build-check-*,
# 于是 .codex-build-slash-* / .codex-theme-build-* 等 9 个目录一直以未跟踪状态
# 躺在仓库根,每次 git status 都是一屏噪音。一网打尽。
.verify-dist-*
.verify-build-*
.build-verify-*
.build-check-*
build-verify-*
.codex-build-*
.codex-theme-build-*
.codex-verify-build-*
.codex-*.log
dist-ssr
*.local
server-data/
.credentials.key
*.credentials.key
.artifacts/
.env
.env.*
!.env.example
.tmp/
.npm-cache/
/.electron-builder-cache/
/.playwright-cli/

# Runtime/user content and local reports. Keep these root-scoped so test
# fixtures in nested source directories can still be committed deliberately.
/uploads/
/attachments/
/coverage/
/tmp/
/temp/
/artifacts/
/.tmp-*/

# Generated root-level test/repro outputs. Keep local copies available without
# ever publishing them as source or release assets.
/echo
/Attachment-background-revision*.html
/Original-replace*.html
/Revised-copy*.html
/*.pptx
/*.docx

# Local databases and sidecars must never be published from the repository root.
/*.db
/*.db-journal
/*.db-wal
/*.db-shm
/*.sqlite
/*.sqlite-journal
/*.sqlite-wal
/*.sqlite-shm
/*.sqlite3
/*.sqlite3-journal
/*.sqlite3-wal
/*.sqlite3-shm

# Invalid SQLite paths from pre-v99 startup coercion bugs. Keep any recovered
# local files on disk, but never allow them into source control.
/undefined
/undefined-journal
/undefined-wal
/undefined-shm

# Certificate/private-key material and generated backup archives.
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
/SHA256SUMS.txt
/*.bak
/*.backup
/*.zip
/*.7z
/*.rar
/*.tar
/*.tar.gz
/*.tgz

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
sample-png/
sample-out/
.worktrees/
output/

# WorkBuddy 本地会话记忆（不入库）
.workbuddy/
