#!/usr/bin/env bash
# yma pre-commit hook
# Guard against secret-redaction tools replacing string literals with "***".
#
# Trigger: staged diff adds assignments like = '***' or = "***".
# Example: STORAGE_KEY = 'yma:activeAgentId' should never be rewritten to "***".
#
# Enable: git config core.hooksPath .githooks
# Bypass: git commit --no-verify

set -e

if git diff --cached --unified=0 | grep -E "^\+.*=\s*['\"]\*\*\*['\"]" > /dev/null; then
  echo "pre-commit: detected '= ***' assignment in staged diff."
  echo "   secret-redaction tool likely overwrote a literal. Review:"
  git diff --cached --unified=0 | grep -nE "^\+.*=\s*['\"]\*\*\*['\"]"
  echo
  echo "If intentional, bypass with: git commit --no-verify"
  exit 1
fi

exit 0
