{
  "$metadata": {
    "tokenSetOrder": ["core", "light", "dark", "white"],
    "source": "src/index.css + tailwind.config.js @ 0.11.72"
  },
  "$themes": [
    { "id": "gugo-light", "name": "Gugo / Light", "selectedTokenSets": { "core": "enabled", "light": "enabled" } },
    { "id": "gugo-dark", "name": "Gugo / Dark", "selectedTokenSets": { "core": "enabled", "dark": "enabled" } },
    { "id": "gugo-white", "name": "Gugo / White", "selectedTokenSets": { "core": "enabled", "white": "enabled" } }
  ],

  "light": {
    "color": {
      "paper": { "$type": "color", "$value": "#F7F8FA", "$description": "页面底色" },
      "paper-2": { "$type": "color", "$value": "#EEF0F3", "$description": "次级底色" },
      "paper-dark": { "$type": "color", "$value": "#111827", "$description": "反色纸面" },
      "sidebar": { "$type": "color", "$value": "#F1F3F5", "$description": "侧栏底色" },
      "surface": { "$type": "color", "$value": "#FFFFFF", "$description": "卡片/浮层表面" },
      "ink": { "$type": "color", "$value": "#1F2937", "$description": "正文" },
      "ink-soft": { "$type": "color", "$value": "#4B5563", "$description": "次级文本" },
      "ink-fade": { "$type": "color", "$value": "#6B7280", "$description": "弱化文本" },
      "ink-ghost": { "$type": "color", "$value": "#6B7280", "$description": "占位文本" },
      "skel": { "$type": "color", "$value": "#E5E7EB", "$description": "骨架屏" },
      "skel-2": { "$type": "color", "$value": "#D1D5DB", "$description": "骨架屏高亮" },
      "accent": { "$type": "color", "$value": "#16A34A", "$description": "主强调色（固定品牌色）" },
      "accent-contrast": { "$type": "color", "$value": "#000000", "$description": "压在 accent 上的前景，运行时按 WCAG 计算" },
      "accent-ink": { "$type": "color", "$value": "#166534", "$description": "纸面上的强调色文本" },
      "accent-soft": { "$type": "color", "$value": "#16A34A2E", "$description": "accent 18% 淡底" },
      "accent-line": { "$type": "color", "$value": "#16A34A8C", "$description": "accent 55% 描边" },
      "accent-glow": { "$type": "color", "$value": "#16A34A1A", "$description": "accent 10% 辉光" },
      "danger": { "$type": "color", "$value": "#B42318", "$description": "错误/破坏性操作" },
      "warning": { "$type": "color", "$value": "#8A4B08", "$description": "未完成/等待批准" },
      "running": { "$type": "color", "$value": "#0369A1", "$description": "执行中/加载中" },
      "success": { "$type": "color", "$value": "#067647", "$description": "已完成" },
      "focus": { "$type": "color", "$value": "#2563EB", "$description": "键盘焦点环" },
      "cyan": { "$type": "color", "$value": "#2E8FA3", "$description": "次要强调" },
      "cyan-soft": { "$type": "color", "$value": "#2E8FA324", "$description": "cyan 14% 淡底" },
      "selected": { "$type": "color", "$value": "#F3F4F6", "$description": "选中行" },
      "row-hover": { "$type": "color", "$value": "#F9FAFB", "$description": "悬停行" },
      "tip-bg": { "$type": "color", "$value": "#1E1E1E", "$description": "提示气泡底" },
      "tip-fg": { "$type": "color", "$value": "#FFFFFF", "$description": "提示气泡文字" },
      "shadow": { "$type": "color", "$value": "#14181F", "$description": "阴影基色" },
      "text-strong": { "$type": "color", "$value": "#111111", "$description": "最强文本" },
      "code-bg": { "$type": "color", "$value": "#F6F8FA", "$description": "代码块底" },
      "code-text": { "$type": "color", "$value": "#24292F", "$description": "代码块文字" },
      "code-fade": { "$type": "color", "$value": "#6B7280", "$description": "代码弱化" },
      "code-fade-hover": { "$type": "color", "$value": "#4B5563", "$description": "代码弱化悬停" },
      "neutral-50": { "$type": "color", "$value": "#FAFAFA" },
      "neutral-100": { "$type": "color", "$value": "#F5F5F5" },
      "neutral-200": { "$type": "color", "$value": "#E5E7EB" },
      "neutral-300": { "$type": "color", "$value": "#D1D5DB" },
      "neutral-400": { "$type": "color", "$value": "#9CA3AF" },
