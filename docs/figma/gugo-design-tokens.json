  "core": {
    "radius": {
      "card": { "$type": "dimension", "$value": "16px" },
      "control": { "$type": "dimension", "$value": "10px" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "type": {
      "page": { "$type": "dimension", "$value": "28px", "$description": "页面标题" },
      "section": { "$type": "dimension", "$value": "20px", "$description": "区块标题" },
      "body": { "$type": "dimension", "$value": "15px", "$description": "正文" },
      "ui": { "$type": "dimension", "$value": "14px", "$description": "控件文字" },
      "meta": { "$type": "dimension", "$value": "12px", "$description": "最小可读元信息，不得更小" }
    },
    "font": {
      "ui": { "$type": "fontFamilies", "$value": "-apple-system, BlinkMacSystemFont, \"Segoe UI Variable\", \"Segoe UI\", \"Inter\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif" },
      "mono": { "$type": "fontFamilies", "$value": "\"JetBrains Mono\", \"Noto Sans Mono CJK SC\", ui-monospace, \"SFMono-Regular\", Menlo, Monaco, Consolas, \"Liberation Mono\", monospace" },
      "hand": { "$type": "fontFamilies", "$value": "Caveat, Kalam, cursive", "$description": "手写体，装饰用" },
      "print": { "$type": "fontFamilies", "$value": "\"Architects Daughter\", Kalam, cursive", "$description": "手绘体，装饰用" },
      "display": { "$type": "fontFamilies", "$value": "\"Cormorant Garamond\", Georgia, serif", "$description": "展示衬线" }
