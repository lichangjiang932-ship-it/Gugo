{
  "name": "your-model-atelier",
  "private": true,
  "version": "0.10.0",
  "description": "Self-hosted browser-based AI workspace for agents, tools, memory, jobs, and MCP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lichangjiang932-ship-it/your-model-atelier.git"
  },
  "bugs": {
    "url": "https://github.com/lichangjiang932-ship-it/your-model-atelier/issues"
  },
  "homepage": "https://github.com/lichangjiang932-ship-it/your-model-atelier#readme",
  "keywords": [
    "ai-agent",
    "self-hosted",
    "mcp",
    "llm",
    "react",
    "sqlite"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "type": "module",
  "bin": {
    "yma-cli": "./bin/yma-cli.js"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "lint": "eslint .",
    "test": "node scripts/run-tests.js",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "i18n:check": "node --test tests/i18nHardcoded.test.js tests/i18n.test.js",
    "debt:check": "node --test tests/codeDebt.test.js",
    "licenses": "node scripts/check-licenses.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "serve": "node server/start.js",
    "hub": "node server/hub/index.js",
    "local": "npm run build && npm run serve",
    "preview": "vite preview --configLoader runner",
    "seed:skills": "node server/seedSystemSkills.js",
    "cli": "node bin/yma-cli.js"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@tailwindcss/typography": "^0.5.19",
    "better-sqlite3": "^12.10.0",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "jsdom": "^29.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.170.0",
    "undici": "7.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "undici": "7.29.0"
  }
}
