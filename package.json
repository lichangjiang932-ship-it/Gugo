{
  "name": "gugo",
  "private": true,
  "version": "0.11.35",
  "description": "Self-hosted AI workspace for browser and Windows desktop with agents, tools, memory, jobs, and MCP.",
  "author": "lichangjiang932-ship-it",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lichangjiang932-ship-it/Gugo.git"
  },
  "bugs": {
    "url": "https://github.com/lichangjiang932-ship-it/Gugo/issues"
  },
  "homepage": "https://github.com/lichangjiang932-ship-it/Gugo#readme",
  "keywords": [
    "ai-agent",
    "self-hosted",
    "mcp",
    "llm",
    "react",
    "sqlite"
  ],
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "type": "module",
  "main": "desktop/main.js",
  "bin": {
    "gugo": "./bin/yma-cli.js",
    "yma-cli": "./bin/yma-cli.js"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "audit:prod": "node scripts/audit-production.mjs",
    "lint": "eslint .",
    "test": "node scripts/run-tests.js",
    "eval:offline": "node scripts/run-tests.js offline-eval",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "i18n:check": "node --test tests/i18nHardcoded.test.js tests/i18n.test.js",
    "debt:check": "node --test tests/codeDebt.test.js",
    "benchmark:checkpoint": "node scripts/benchmark-loop-checkpoint.mjs",
    "licenses": "node scripts/check-licenses.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "serve": "node server/start.js",
    "hub": "node server/hub/start.js",
    "local": "npm run build && npm run serve",
    "desktop:dev": "node desktop/dev.mjs",
    "desktop:start": "npm run build && electron .",
    "desktop:check": "node --check desktop/main.js && node --check desktop/updateRuntime.js && node --check desktop/dev.mjs && node --check desktop/preload.cjs && node --test tests/desktopSecurity.test.js tests/desktopPackaging.test.js tests/desktopUpdateRuntime.test.js",
    "desktop:verify-package": "node scripts/verify-desktop-package.cjs",
    "desktop:smoke-package": "node scripts/smoke-test-desktop-package.mjs",
    "desktop:media-sidecars": "node scripts/prepare-media-sidecars.mjs",
    "desktop:package": "npm run desktop:media-sidecars && electron-builder --win nsis --publish never && npm run desktop:smoke-package",
    "desktop:dist": "npm run build && npm run desktop:check && npm run desktop:package",
    "desktop:publish": "npm run build && npm run desktop:check && npm run desktop:media-sidecars && electron-builder --win nsis --publish always",
    "preview": "vite preview --configLoader runner",
    "seed:skills": "node server/seedSystemSkills.js",
    "cli": "node bin/yma-cli.js"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@napi-rs/canvas": "^0.1.65",
    "@vscode/ripgrep": "1.18.0",
    "acorn": "^8.18.0",
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.8.9",
    "fontkit": "^2.0.4",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "jsdom": "^29.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "node-unrar-js": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3",
    "undici": "7.29.0",
    "ws": "^8.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@eslint/js": "^10.0.1",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.25",
    "sucrase": "^3.35.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.6",
    "nanoid": "3.3.17",
    "undici": "7.29.0"
  }
}
