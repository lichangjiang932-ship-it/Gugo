# =============================================================================
# Gugo — 环境变量样例
#   1) 复制为 .env (本地不会被 git 跟踪)
#   2) 选一个上游 provider 取消注释,填上自己的 key
#   3) 邮件 SMTP 选填,不填会进开发模式直接在登录页显示验证码
# =============================================================================

# ──────────────────────────────────────────────
# 上游模型 (任选其一,把对应一段取消注释覆盖默认)
# ──────────────────────────────────────────────

# [默认] DeepSeek (官方)
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
MODEL_NAMES=deepseek-chat,deepseek-reasoner
MODEL_API_KEY=sk-your-deepseek-key
MODEL_PRICE_MULTIPLIERS=deepseek-chat:1,deepseek-reasoner:3

# [可选] OpenAI / Azure OpenAI 兼容端点
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
# MODEL_NAMES=gpt-4o,gpt-4o-mini,o1-mini
# MODEL_API_KEY=sk-your-openai-key
# MODEL_PRICE_MULTIPLIERS=gpt-4o:10,gpt-4o-mini:1,o1-mini:6

# [可选] Anthropic Claude (通过 OpenAI 兼容代理,如 one-api / openrouter)
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=anthropic/claude-sonnet-4
# MODEL_NAMES=anthropic/claude-sonnet-4,anthropic/claude-opus-4
# MODEL_API_KEY=sk-or-your-openrouter-key
# MODEL_PRICE_MULTIPLIERS=anthropic/claude-sonnet-4:6,anthropic/claude-opus-4:30

# [可选] 阿里通义 (Dashscope OpenAI 兼容)
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus
# MODEL_NAMES=qwen-plus,qwen-max,qwen-turbo
# MODEL_API_KEY=sk-your-dashscope-key
# MODEL_PRICE_MULTIPLIERS=qwen-plus:1,qwen-max:5,qwen-turbo:0.3

# [可选] 字节豆包 (火山方舟 OpenAI 兼容)
# MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MODEL_NAME=doubao-pro-32k
# MODEL_NAMES=doubao-pro-32k,doubao-lite-128k
# MODEL_API_KEY=your-ark-api-key
# MODEL_PRICE_MULTIPLIERS=doubao-pro-32k:2,doubao-lite-128k:0.5

# [可选] Moonshot Kimi
# MODEL_BASE_URL=https://api.moonshot.cn/v1
# MODEL_NAME=moonshot-v1-32k
# MODEL_NAMES=moonshot-v1-8k,moonshot-v1-32k,moonshot-v1-128k
# MODEL_API_KEY=sk-your-moonshot-key

# [可选] 多 Provider 路由：同一个下拉框里自由选择不同上游的模型。
# 启用 MODEL_PROVIDERS 后，后端会按所选模型自动切换 base URL / API key。
# MODEL_PROVIDERS=deepseek,mimo
# MODEL_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
# MODEL_PROVIDER_DEEPSEEK_API_KEY=sk-your-deepseek-key
# MODEL_PROVIDER_DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
# MODEL_PROVIDER_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MODEL_PROVIDER_MIMO_API_KEY=sk-your-mimo-key
# MODEL_PROVIDER_MIMO_MODELS=mimo-v2.5,mimo-v2.5-pro
# MODEL_NAME=deepseek-v4-pro
# MODEL_PRICE_MULTIPLIERS=deepseek-v4-pro:3,deepseek-v4-flash:0.6,mimo-v2.5:1,mimo-v2.5-pro:3

# 通用模型参数
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=4096
CREDIT_BASE_PER_1K_TOKENS=10

# Models that can accept image attachments. Leave empty to preserve legacy permissive behavior.
# MODEL_NAMES_VISION=gpt-4o,gpt-4o-mini,claude-3-5-sonnet

# ──────────────────────────────────────────────
# 服务监听
# ──────────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=5173

# ──────────────────────────────────────────────
# 工具系统
# ──────────────────────────────────────────────
# 单次对话里模型最多被工具调用回灌多少轮(默认 5,上限 12)
# 调高有助于复杂任务(先 search 再 fetch 再生成),但单次响应时间和扣费会按比例上涨
TOOL_MAX_ROUNDS=5

# Claude/Codex-style local workspace tools (all disabled by default)
# WORKSPACE_ROOT defaults to process.cwd(); set it explicitly for safer deployments.
# WORKSPACE_ROOT=D:\destok\your-model-atelier(1)\your-model-atelier
# WORKSPACE_FS_ENABLED=1
# WORKSPACE_SHELL_ENABLED=1
# WORKSPACE_GIT_ENABLED=1
# WORKSPACE_GIT_MUTATION_ENABLED=1

# ──────────────────────────────────────────────
# 审批门控(approval gating)
# ──────────────────────────────────────────────
# 服务端 agent 循环执行高风险工具(shell / 写文件 / 浏览器代操作 / 外部写请求)前,
# 把这次调用挂起写进收件箱,等用户批准 / 拒绝 / 改写参数后再继续。
#   off        —— 完全关闭,工具直接执行(老行为)
#   unattended —— 默认。只拦无人值守路径(后台 job / 子代理 / cron),
#                 交互式聊天沿用前端已有的 apply_patch 确认弹窗
#   all        —— 交互式聊天也拦
# APPROVAL_MODE=unattended
# 审批超时(毫秒,默认 86400000 = 24h)。超时置 expired,视同拒绝。
# APPROVAL_TIMEOUT_MS=86400000

# MCP client (dangerous stdio transport is opt-in)
# MCP_STDIO_ENABLED=0
# MCP_STDIO_ALLOWED_COMMANDS=npx,node,uvx,python,python3

# Browser tools use an installed Edge/Chrome through the DevTools protocol (Node.js 22+).
# BROWSER_ENABLED=1
# BROWSER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# Normal task sessions are headless by default. App connection always opens a visible
# local login window and reuses the persistent profile under APP_DATA_DIR/browser-profiles.
# BROWSER_HEADLESS=1
# Only for restricted CI/sandbox hosts where Chromium exits with STATUS_ACCESS_DENIED.
# This weakens Chromium process isolation; leave unset on normal desktops.
# BROWSER_NO_SANDBOX=1

# Expose the authenticated Streamable HTTP MCP server at /mcp.
# Use a LAN Access Key (ymak_...) as the Bearer token in external applications.
# MCP_SERVER_ENABLED=1
# MCP_RATE_LIMIT_PER_MINUTE=300
# MCP_MAX_BODY_BYTES=1048576

# Hooks (shell hooks are equivalent to local code execution and stay off by default)
# HOOKS_SHELL_ENABLED=0

# Memory and context compaction
# MEMORY_INJECT_TOKEN_CAP=800
# AUTO_COMPACT=0
# COMPACT_AT_MESSAGES=60
# COMPACT_AT_TOKENS=60000

# (可选) 第三路搜索兜底:DDG/Bing 双双被反爬时,如配了 Tavily / SerpAPI key,自动切换
# TAVILY_API_KEY=tvly-your-key
# SERPAPI_API_KEY=your-serpapi-key

# ──────────────────────────────────────────────
# 邮件 SMTP (选填)
# 不填则进开发模式,登录验证码直接显示在页面
# ──────────────────────────────────────────────
AUTH_DEV_CODES=false
# MAIL_SERVER=smtp.qq.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=your-email@qq.com
# MAIL_PASSWORD=your-smtp-authorization-code
# MAIL_DEFAULT_SENDER=your-email@qq.com

# === Vision Assist 副驾（无视觉模型的图片→文本转换） ===
# DB 中 kind=vision_assist 的集成优先；下面是 fallback。
# VISION_ASSIST_BASE_URL=https://api.openai.com/v1
# VISION_ASSIST_MODEL=gpt-4o-mini
# VISION_ASSIST_API_KEY=
# VISION_ASSIST_LANGUAGE=zh
# VISION_ASSIST_MAX_IMAGES=4
