# =============================================================================
# Gugo — 环境变量样例
#   1) 复制为 .env (本地不会被 git 跟踪)
#   2) 选一个上游 provider 取消注释,填上自己的 key
#   3) 邮件 SMTP 选填,不填会进开发模式直接在登录页显示验证码
# =============================================================================

# [可选] 分层运行配置。优先级从低到高：
# server-data/runtime.json < .gugo/runtime.json < APP_CONFIG_PATH < .env < 系统环境变量。
# JSON 格式为 { "env": { "WORKSPACE_FS_ENABLED": true } }；敏感值仍放环境变量或凭据库。
# APP_CONFIG_PATH=.gugo/runtime.local.json

# ──────────────────────────────────────────────
# 上游模型 (任选其一,把对应一段取消注释覆盖默认)
# ──────────────────────────────────────────────

# [默认] DeepSeek Flash（严格按所选模型执行）
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
MODEL_NAMES=deepseek-v4-flash,deepseek-v4-pro
MODEL_API_KEY=sk-your-deepseek-key

# [可选] OpenAI / Azure OpenAI 兼容端点
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini
# MODEL_NAMES=gpt-4o,gpt-4o-mini,o1-mini
# MODEL_API_KEY=sk-your-openai-key

# [可选] Anthropic Claude (通过 OpenAI 兼容代理,如 one-api / openrouter)
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# MODEL_NAME=anthropic/claude-sonnet-4
# MODEL_NAMES=anthropic/claude-sonnet-4,anthropic/claude-opus-4
# MODEL_API_KEY=sk-or-your-openrouter-key

# [可选] 阿里通义 (Dashscope OpenAI 兼容)
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus
# MODEL_NAMES=qwen-plus,qwen-max,qwen-turbo
# MODEL_API_KEY=sk-your-dashscope-key

# [可选] 字节豆包 (火山方舟 OpenAI 兼容)
# MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MODEL_NAME=doubao-pro-32k
# MODEL_NAMES=doubao-pro-32k,doubao-lite-128k
# MODEL_API_KEY=your-ark-api-key

# [可选] Moonshot Kimi
# MODEL_BASE_URL=https://api.moonshot.cn/v1
# MODEL_NAME=moonshot-v1-32k
# MODEL_NAMES=moonshot-v1-8k,moonshot-v1-32k,moonshot-v1-128k
# MODEL_API_KEY=sk-your-moonshot-key

# [可选] 多 Provider 路由：同一个下拉框里自由选择不同上游的模型。
# 启用 MODEL_PROVIDERS 后，后端会按所选模型自动切换 base URL / API key。
# MODEL_PROVIDERS=deepseek,mimo
# MODEL_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
# MODEL_PROVIDER_DEEPSEEK_API_KEY=sk-your-deepseek-key
# MODEL_PROVIDER_DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
# MODEL_PROVIDER_MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MODEL_PROVIDER_MIMO_API_KEY=sk-your-mimo-key
# MODEL_PROVIDER_MIMO_MODELS=mimo-v2.5,mimo-v2.5-pro
# MODEL_NAME=deepseek-v4-flash

# ──────────────────────────────────────────────
# 本地模型 (Ollama / LM Studio / llama.cpp / vLLM)
#
# ⚠ 服务必须从**仓库根目录**启动,否则 .env 会被静默忽略
#   (server/utils/runtimeEnv.js 按 process.cwd() 找 .env,找不到就返回空对象)。
#
# 本地端点会被自动识别(回环 + 局域网 192.168/10.x/172.16-31 + Tailscale 100.64/10),
# 识别后自动获得更宽松的超时(首 token 10 分钟)，且不会静默切到云端。
# 下面这些超时/能力值**全部可以不填**,填了才覆盖自动推断。
# ──────────────────────────────────────────────

# [可选] Ollama —— 填 origin 即可,缺的 /v1 会自动补上
# MODEL_BASE_URL=http://127.0.0.1:11434/v1
# MODEL_NAME=qwen2.5:7b
# MODEL_NAMES=qwen2.5:7b,llama3.1:8b
# MODEL_API_KEY=
# 模型常驻显存的时长。不设的话 Ollama 默认 5 分钟就卸载,
# 下次请求要重新加载几个 G 的权重 —— 这是「本地模型很慢」最常见的原因。
# OLLAMA_KEEP_ALIVE=30m

# [可选] LM Studio —— 注意必须带 /v1
# MODEL_BASE_URL=http://127.0.0.1:1234/v1
# MODEL_NAME=qwen2.5-7b-instruct
# MODEL_API_KEY=

# [可选] llama.cpp server
# MODEL_BASE_URL=http://127.0.0.1:8080/v1
# MODEL_NAME=local-model
# llama.cpp 默认按「不支持 function calling」处理(取决于启动参数和 chat template,
# 发了不支持的 tools 会整轮 400)。确认支持后用下面这行显式打开:
# MODEL_NAMES_TOOLS=local-model

# [可选] vLLM
# MODEL_BASE_URL=http://127.0.0.1:8000/v1
# MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# [可选] Anthropic 原生 Messages API（无需 OpenAI 兼容网关）
# MODEL_BASE_URL=https://api.anthropic.com
# MODEL_NAME=claude-sonnet-4-5
# MODEL_API_KEY=sk-ant-...

# [可选] Gemini 原生 generateContent API（裸域名会自动补 /v1beta）
# MODEL_BASE_URL=https://generativelanguage.googleapis.com
# MODEL_NAME=gemini-2.5-pro
# MODEL_API_KEY=...

# 超时(毫秒)。留空 = 本地端点自动用宽松值,云端沿用原来的 60s/120s。
# 首 token 超时:从发请求到第一个字。本地加载权重可能几十秒甚至几分钟。
# MODEL_FIRST_TOKEN_TIMEOUT_MS=600000
# 空闲超时:两个 chunk 之间的最大间隔。★ 不是整请求超时 ——
# 只要模型还在吐字就永远不会被砍断,CPU 上 1 tok/s 也能跑完。
# MODEL_IDLE_TIMEOUT_MS=120000
# 端点探测(/models、/api/tags)超时。Ollama 冷启动时 8s 会不够。
# MODEL_PROBE_TIMEOUT_MS=30000
# 后台任务(agent / 子代理)单次模型调用超时。
# MODEL_BACKGROUND_TIMEOUT_MS=600000

# 通用模型参数
MODEL_TEMPERATURE=0.7
# 单次输出 token 硬顶。推理内容和正文共同计入，防止异常请求无限消耗算力或上游额度。
MODEL_MAX_TOKENS=16384
# 上下文窗口用于长任务在 80% 水位自动压缩；多模型可用 JSON 或 model=token 逗号列表覆盖。
#
# ⚠ 本地模型**一定要按实际值填**(或在设置页用「检测模型」自动探测)。
# 填大了会导致压缩永远不触发,长对话必然撞上游 400;
# Ollama 可以通过设置页的检测按钮从 /api/show 自动读出真实值。
# 不填时:本地端点默认按 8192 算,云端按 128000 算。
MODEL_CONTEXT_WINDOW=128000
# MODEL_CONTEXT_WINDOWS={"deepseek-chat":128000,"qwen2.5:7b":32768}

# Models that can accept image attachments. Leave empty to preserve legacy permissive behavior.
# ⚠ 本地端点默认按「不支持图片」处理(绝大多数本地模型是纯文本的),
# 要用 llava / qwen-vl 之类的本地视觉模型必须在这里显式列出。
# MODEL_NAMES_VISION=gpt-4o,gpt-4o-mini,claude-3-5-sonnet
# 原生 PDF / 并行工具能力白名单。设置后即为精确名单；
# 未设置时 OpenAI、Anthropic、Gemini 官方端点自动开启。
# MODEL_NAMES_PDF=gpt-4o,gpt-4.1
# MODEL_NAMES_PARALLEL_TOOLS=gpt-4o,gpt-4.1

# 支持 function calling 的模型白名单。留空 = 按端点类型自动推断。
# 一旦设置就是精确名单:不在名单里的模型不会收到 tools。
# MODEL_NAMES_TOOLS=qwen2.5:7b,llama3.1:8b

# ──────────────────────────────────────────────
# Agent 工作量上限（全部可选，默认已放得很宽）
#
# ★ 设计原则：这些是**死循环护栏**，不是给正常工作设的预算。
#   正常任务（哪怕读完整个项目再逐个文件改）都碰不到它们。
#   如果你发现任务「做到一半停了」，先看是不是撞了这里，而不是加限制。
#   随时可以点「停止」手动中断，所以护栏可以给得很松。
# ──────────────────────────────────────────────

# 后台任务（Job）单步最多几轮工具调用。默认 2000。
# JOB_MAX_ITERS=2000
# 整个 Job 累积最多几次工具调用。默认 2000，这是真正的收敛点。
# JOB_MAX_TOOL_CALLS=2000
# Job 墙钟上限（毫秒）。默认 6 小时；设 0 = 不限时间。
# ⚠ 这个时间**不含等模型的时间**，只统计工具真正执行的耗时——
#   所以本地慢模型不会因为「想得久」被判超时。
# JOB_MAX_WALL_MS=21600000
# 后台 Job 并发槽位（不同 Job 可并行；同一 Job 永不重入，范围 1-32）
# JOB_RUNTIME_CONCURRENCY=4
# 后台任务累计模型调用、真实 token 与美元硬顶。0 = 显式关闭该项。
# 美元核算需要同时配置 MODEL_USD_RATES；未配置时 token 硬顶仍然生效。
JOB_MAX_MODEL_CALLS=100
JOB_MAX_MODEL_TOKENS=200000
JOB_MAX_COST_USD=5

# 每百万 token 的美元价格（input/output），按实际供应商账单填写，不猜价格。
# MODEL_USD_RATES={"deepseek-v4-flash":{"input":0.1,"output":0.2},"deepseek-v4-pro":{"input":1,"output":2}}

# 子代理单次运行最多几轮。默认 1000。
# SUBAGENT_MAX_ITERS=1000
# 子代理累积工具调用数 / 墙钟。默认 1000 次 / 2 小时。
# SUBAGENT_MAX_TOOL_CALLS=1000
# SUBAGENT_MAX_WALL_MS=7200000
# 每个用户同时最多跑几个子代理。默认 8。
# SUBAGENT_MAX_CONCURRENT=8
# 子代理嵌套深度上限。默认 3（主任务 → 子 → 孙）。
# SUBAGENT_MAX_DEPTH=3
# 一批最多派几个子代理。默认 8。
# SUBAGENT_MAX_PER_BATCH=8

# 任务规划阶段每个探索者最多几轮。默认 40。
# PLANNING_EXPLORER_MAX_ITERS=40

# 单个工具结果喂回模型的字符上限。默认 24000。
# 调小会让模型只看到文件的一部分却不自知，结论不可靠；
# 真正防上下文溢出的是自动压缩，不是这个。
# TOOL_OUTPUT_MAX_CHARS=24000

# 前端聊天的工具调用轮数上限。默认 0 = 不限制（循环靠模型自己停）。
# TOOL_MAX_ROUNDS=0

# ──────────────────────────────────────────────
# 故障转移与模型选择
# ──────────────────────────────────────────────

# 是否允许「转移到一个**不同名**的模型」。默认 0（不允许）。
#
# ★ 开了会发生什么：你在 UI 里选了 deepseek-v4-flash，
#   deepseek 网络抖一下触发转移，而备用 provider 没有这个模型名，
#   就会回落到它的第一个模型（比如 mimo-v2.5）跑完。输出能力、延迟和
#   供应商 API 成本都可能与用户选择不同，因此默认禁止跨模型回退。
#
# 同名模型在多个 provider 之间转移（镜像/中转站）不受这个开关影响，始终允许。
# MODEL_FAILOVER_CROSS_MODEL=0

# 严格模型粘滞。1 = 请求哪个模型就只允许执行同名模型；即使开启跨模型
# failover 也不会静默换成 Pro 或其它厂商模型。明确接受能力和成本变化时才设 0。
MODEL_STRICT_SELECTION=1

# 单次请求「思考过程」的字符上限，0 = 不限。默认 60000（≈30k token）。
#
# ★ 推理模型在信息不足时（例如工具一直失败）会陷入「再想想」的循环，
#   它自己不会停。实测有一轮思考了 167644 字（≈84000 token），
#   却没有给出任何结论。到达上限会中止请求并明确报错，而不是继续占用
#   本地算力或上游额度等待一个可能永远不来的正文。
MODEL_REASONING_MAX_CHARS=60000

# ──────────────────────────────────────────────
# 服务监听
# ──────────────────────────────────────────────
SERVER_HOST=127.0.0.1
# ★ dev(npm run dev)和 prod(npm run serve)**共用**这一个端口，这是故意的。
#
# 登录 token 和轻量偏好存在 localStorage，会话与历史存在 IndexedDB，
# 两者都按浏览器 origin（协议+主机+端口）隔离。
# 端口一变就是一套全新的存储 —— 表现为「登录状态没了、历史对话全空」。
# 注意 localhost 和 127.0.0.1 也算不同 origin，所以 SERVER_HOST 也别乱改。
#
# vite 已设 strictPort：端口被占直接报错，不会静默换一个端口
# （静默换端口正是「同一条命令这次能看到历史、下次看不到」的元凶）。
SERVER_PORT=5175
# 只想让 dev server 用不同端口时才设这个（一般不需要，设了就会和 prod 分裂存储）
# VITE_DEV_PORT=5175

# 聊天统一使用服务端 TurnEngine：浏览器只提交轮次并消费事件，
# 模型/工具/审批/取消/断点均由服务端持有。不再提供旧前端工具循环开关。

# ──────────────────────────────────────────────
# 工具系统
# ──────────────────────────────────────────────
# 单次对话里模型最多被工具调用回灌多少轮。★ 默认 0 = 不限制。
#
# 工具循环本来就会在模型停止调工具时自然退出,想中断随时点「停止生成」。
# 设死上限会把模型切在半路 —— 读一个中等项目光 list_directory + read_file
# 就要十几轮,只留下一句「让我继续」,用户付了钱却拿不到结论。
# Claude Code / Codex / openworker 都不设这种硬顶。
#
# 只有受控/演示环境才需要封顶,填 1..1000 的正数即可。
TOOL_MAX_ROUNDS=20

# Claude/Codex-style local workspace tools (all disabled by default)
# WORKSPACE_ROOT defaults to process.cwd(); set it explicitly for safer deployments.
# WORKSPACE_ROOT=/path/to/your-model-atelier
# WORKSPACE_FS_ENABLED=1
# 未信任目录即使已授权也仅可读；写入、Shell、Git 必须逐用户显式信任。
# 仅单机可信用户场景可用下面开关跳过逐用户工作区信任。
# WORKSPACE_SHARED_TRUSTED=0
# WORKSPACE_SHELL_ENABLED=1
# WORKSPACE_GIT_ENABLED=1
# WORKSPACE_GIT_MUTATION_ENABLED=1

# Optional per-repository policy. After a user explicitly trusts a workspace,
# .gugo/config.json may only tighten the global switches above; it can never enable
# a capability disabled here. Example:
# { "permissions": { "fileSystem": true, "fileSystemWrite": true, "shell": false, "git": true, "gitMutation": false } }

# ──────────────────────────────────────────────
# 审批门控(approval gating)
# ──────────────────────────────────────────────
# 服务端 agent 循环执行高风险工具(shell / 写文件 / 浏览器代操作 / 外部写请求)前,
# 把这次调用挂起写进收件箱,等用户批准 / 拒绝 / 改写参数后再继续。
#   off        —— 完全关闭,工具直接执行(老行为)
#   unattended —— 默认。只拦无人值守路径(后台 job / 子代理 / cron),
#                 交互式聊天沿用前端已有的 apply_patch 确认弹窗
#   all        —— 交互式聊天也拦
# APPROVAL_MODE=unattended
# 审批超时(毫秒,默认 86400000 = 24h)。超时置 expired,视同拒绝。
# APPROVAL_TIMEOUT_MS=86400000

# Turn events are retained and removed as complete turns so replay is never partially truncated.
# Expired turns (including abandoned non-terminal turns) are removed after the retention window.
# TURN_EVENT_RETENTION_DAYS=30
# TURN_EVENT_MAX_TERMINAL_TURNS_PER_USER=1000
# TURN_EVENT_CLEANUP_INTERVAL_MS=300000

# MCP client (dangerous stdio transport is opt-in)
# MCP_STDIO_ENABLED=0
# MCP_STDIO_ALLOWED_COMMANDS=npx,node,uvx,python,python3
# Public origin used to build MCP OAuth callback URLs behind a reverse proxy.
# Set this in production. Without it, Host and X-Forwarded-* are ignored and
# the callback uses SERVER_HOST/SERVER_PORT. Only trust proxy headers when the
# reverse proxy strips client-supplied forwarding headers.
# APP_PUBLIC_URL=https://atelier.example.com
# TRUST_PROXY=0

# Custom bridge webhook authentication (provider=webhook/wechat):
# X-Gugo-Timestamp: Unix seconds (or milliseconds)
# X-Gugo-Signature: sha256=<HMAC-SHA256(secret, timestamp + "." + raw_request_body)>
# Timestamps older/newer than 5 minutes and duplicate deliveries are rejected.
# Compatible aliases: X-Webhook-Timestamp / X-Signature-Timestamp and
# X-Signature-256 / X-Hub-Signature-256. timestamp + raw_body is also accepted.

# Browser tools use an installed Edge/Chrome through the DevTools protocol (Node.js 22+).
# BROWSER_ENABLED=1
# BROWSER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# Normal task sessions are headless by default. App connection always opens a visible
# local login window and reuses the persistent profile under APP_DATA_DIR/browser-profiles.
# BROWSER_HEADLESS=1
# Only for restricted CI/sandbox hosts where Chromium exits with STATUS_ACCESS_DENIED.
# This weakens Chromium process isolation; leave unset on normal desktops.
# BROWSER_NO_SANDBOX=1

# Expose the authenticated Streamable HTTP MCP server at /mcp.
# Use a LAN Access Key (ymak_...) as the Bearer token in external applications.
# MCP_SERVER_ENABLED=1
# MCP_RATE_LIMIT_PER_MINUTE=300
# MCP_MAX_BODY_BYTES=1048576

# Hooks (shell hooks are equivalent to local code execution and stay off by default)
# HOOKS_SHELL_ENABLED=0
# Even when enabled, every executable must be explicitly listed (name or absolute path).
# HOOKS_SHELL_ALLOWED_COMMANDS=node,python

# Authenticated model connectivity checks are limited per user and minute.
# MODEL_TEST_RATE_MAX=10

# Public mobile access-key handshakes per trusted client address per 15 minutes.
# MOBILE_HANDSHAKE_RATE_MAX=10

# Connector OAuth (optional; manual token setup remains available)
# Public origin registered as the OAuth callback base, for example http://localhost:5175
# APP_PUBLIC_URL=http://localhost:5175
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_SCOPES=read:user
# NOTION_OAUTH_CLIENT_ID=
# NOTION_OAUTH_CLIENT_SECRET=
# SLACK_OAUTH_CLIENT_ID=
# SLACK_OAUTH_CLIENT_SECRET=
# SLACK_OAUTH_SCOPES=channels:read,channels:history
# GOOGLE_DRIVE_OAUTH_CLIENT_ID=
# GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
# GOOGLE_DRIVE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.readonly

# Credential encryption at rest (optional; a local 0600 key is generated beside the DB when unset)
# Use exactly 32 random bytes encoded as base64 or 64 hex characters. Back this key up securely.
# CREDENTIAL_ENCRYPTION_KEY=
# CREDENTIAL_KEY_PATH=

# Memory and context compaction
# MEMORY_INJECT_TOKEN_CAP=800
# AUTO_COMPACT=0
# COMPACT_AT_MESSAGES=60
# COMPACT_AT_TOKENS=60000

# (可选) 第三路搜索兜底:DDG/Bing 双双被反爬时,如配了 Tavily / SerpAPI key,自动切换
# TAVILY_API_KEY=tvly-your-key
# SERPAPI_API_KEY=your-serpapi-key

# ──────────────────────────────────────────────
# 邮件 SMTP (选填)
# 不填则进开发模式,登录验证码直接显示在页面
# ──────────────────────────────────────────────
AUTH_DEV_CODES=false
# MAIL_SERVER=smtp.qq.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=your-email@example.com
# MAIL_PASSWORD=your-smtp-authorization-code
# MAIL_DEFAULT_SENDER=your-email@example.com

# === Vision Assist 副驾（无视觉模型的图片→文本转换） ===
# DB 中 kind=vision_assist 的集成优先；下面是 fallback。
# VISION_ASSIST_BASE_URL=https://api.openai.com/v1
# VISION_ASSIST_MODEL=gpt-4o-mini
# VISION_ASSIST_API_KEY=
# VISION_ASSIST_LANGUAGE=zh
# VISION_ASSIST_MAX_IMAGES=4
